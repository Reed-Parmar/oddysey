# Copy to backend/.env (gitignored). Never commit real values. Full list: docs/deployment.md §2.
APP_ENV=development

# Owner role, used only by `alembic upgrade` and scripts.bootstrap_db.
# Use the SESSION POOLER (IPv4); db.<ref>.supabase.co is IPv6-only.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Runtime role spa_api. Written by `uv run python -m scripts.bootstrap_db`.
DATABASE_URL=

SUPABASE_URL=https://<project-ref>.supabase.co
# Secret (service-role) key: needed for submission FILE uploads/downloads (Supabase Storage). URL-only
# submissions work without it. Server only, never in the frontend.
SUPABASE_SECRET_KEY=
# Leave empty for projects with asymmetric JWT signing keys (JWKS). Legacy HS256 only: >= 32 chars.
SUPABASE_JWT_SECRET=
AUTH_JWT_AUDIENCE=authenticated
STORAGE_BUCKET=submissions
RESUME_BUCKET=resumes
PROJECT_DOC_BUCKET=project-docs
MAX_UPLOAD_BYTES=10485760
MAX_RESUME_BYTES=5242880
RESUME_UPLOADS_PER_HOUR=5
MAX_IMPORT_BYTES=5242880

# Optional: without a key, matching is rule-only (as always), resume extraction uses keyword matching, project
# metadata uses a labelled rule fallback and automated report evaluation is 'unavailable' (supervisor review).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Project Assistant models (separate per-model daily token budget; ADR-023)
ASSISTANT_MODEL=openai/gpt-oss-120b
ASSISTANT_FALLBACK_MODEL=qwen/qwen3.8-27b
# Optional local Ollama fallback (ADR-022): used if Groq fails or is not configured. Leave empty to disable.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
AI_TIMEOUT_SECONDS=10
AI_CONCURRENCY=4

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_REGEX=
FRONTEND_BASE_URL=http://localhost:5173

# ADR-017 automation. Run the worker with `uv run python -m app.worker`, or set RUN_WORKER_IN_API=true for a
# single process (demos / one Render web service).
RUN_WORKER_IN_API=false
ALLOCATION_INTERVAL_MINUTES=15
ARCHIVE_GRACE_DAYS=7
JOB_LEASE_SECONDS=300
# Report links submitted by trainees are fetched for analysis (https only; private addresses blocked).
REPORT_URL_FETCH_ENABLED=true
# Originality review bands (configurable heuristics, not probabilities).
ORIGINALITY_MEDIUM_AT=15
ORIGINALITY_HIGH_AT=40

# Notification email: disabled (in-app only) | console (logs kind/id, never addresses) | smtp
EMAIL_BACKEND=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
LOG_LEVEL=INFO

# Demo seed only (scripts.seed generates it on first run). Never set permanently on Render.
SEED_DEMO_PASSWORD=
