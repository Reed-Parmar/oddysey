# Copy to frontend/.env.local. Public values only: never put secret keys here.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>
# ADR-031: domain of phone-derived trainee login emails; must equal the API's TRAINEE_LOGIN_EMAIL_DOMAIN (optional).
VITE_TRAINEE_LOGIN_DOMAIN=trainee.spa.local
