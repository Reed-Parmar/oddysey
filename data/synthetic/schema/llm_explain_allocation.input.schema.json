{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "theory": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Theory"
        },
        "practical": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Practical"
        },
        "safety": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Safety"
        }
      },
      "required": [
        "theory",
        "practical",
        "safety"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "AssignedFacts": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "$ref": "#/$defs/ProjectBrief"
        },
        "facts": {
          "$ref": "#/$defs/EngineFacts"
        },
        "assignment_source": {
          "enum": [
            "auto_best_eligible",
            "replacement_ranked"
          ],
          "title": "Assignment Source",
          "type": "string"
        },
        "replacement_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Replacement Rank"
        },
        "replacement_pool_eligible": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Replacement Pool Eligible"
        }
      },
      "required": [
        "project",
        "facts",
        "assignment_source",
        "replacement_rank",
        "replacement_pool_eligible"
      ],
      "title": "AssignedFacts",
      "type": "object"
    },
    "EngineFacts": {
      "additionalProperties": false,
      "properties": {
        "project_code": {
          "title": "Project Code",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "ineligible_reasons": {
          "items": {
            "enum": [
              "trade_mismatch",
              "below_min_practical",
              "verified_assessment_required",
              "below_min_match"
            ],
            "type": "string"
          },
          "title": "Ineligible Reasons",
          "type": "array"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "mode": {
          "enum": [
            "full",
            "profile"
          ],
          "title": "Mode",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/FactorFact"
          },
          "title": "Factors",
          "type": "array"
        }
      },
      "required": [
        "project_code",
        "eligible",
        "ineligible_reasons",
        "score",
        "mode",
        "factors"
      ],
      "title": "EngineFacts",
      "type": "object"
    },
    "FactorFact": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "points": {
          "title": "Points",
          "type": "number"
        },
        "max_points": {
          "title": "Max Points",
          "type": "integer"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "points",
        "max_points",
        "detail"
      ],
      "title": "FactorFact",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "trades": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Trades",
          "type": "array"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "career_interest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Career Interest"
        },
        "background": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Background"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "score_mode": {
          "enum": [
            "full",
            "profile"
          ],
          "title": "Score Mode",
          "type": "string"
        }
      },
      "required": [
        "trades",
        "skills",
        "career_interest",
        "background",
        "assessment",
        "score_mode"
      ],
      "title": "Profile",
      "type": "object"
    },
    "ProjectBrief": {
      "additionalProperties": false,
      "properties": {
        "project_code": {
          "title": "Project Code",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "trades": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Trades",
          "type": "array"
        },
        "difficulty": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "min_practical_score": {
          "title": "Min Practical Score",
          "type": "number"
        },
        "min_match_score": {
          "title": "Min Match Score",
          "type": "number"
        },
        "required_skills": {
          "items": {
            "type": "string"
          },
          "title": "Required Skills",
          "type": "array"
        }
      },
      "required": [
        "project_code",
        "title",
        "category",
        "trades",
        "difficulty",
        "min_practical_score",
        "min_match_score",
        "required_skills"
      ],
      "title": "ProjectBrief",
      "type": "object"
    },
    "RankedProject": {
      "additionalProperties": false,
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "project_code": {
          "title": "Project Code",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "rank",
        "project_code",
        "score"
      ],
      "title": "RankedProject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "eligible_ready_projects": {
      "minimum": 0,
      "title": "Eligible Ready Projects",
      "type": "integer"
    },
    "best_individual": {
      "anyOf": [
        {
          "$ref": "#/$defs/RankedProject"
        },
        {
          "type": "null"
        }
      ]
    },
    "assigned": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssignedFacts"
        },
        {
          "type": "null"
        }
      ]
    },
    "rejected_project_codes": {
      "items": {
        "type": "string"
      },
      "title": "Rejected Project Codes",
      "type": "array"
    },
    "waiting_reason": {
      "anyOf": [
        {
          "enum": [
            "no_ready_projects",
            "all_ready_projects_rejected",
            "no_project_for_trades",
            "verified_assessment_required",
            "below_min_practical",
            "below_min_match",
            "no_eligible_project"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Waiting Reason"
    },
    "capacity_note": {
      "title": "Capacity Note",
      "type": "string"
    }
  },
  "required": [
    "profile",
    "eligible_ready_projects",
    "best_individual",
    "assigned",
    "rejected_project_codes",
    "waiting_reason",
    "capacity_note"
  ],
  "title": "AllocationInput",
  "type": "object"
}
